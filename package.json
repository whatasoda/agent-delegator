{
  "name": "@whatasoda/agent-delegator",
  "version": "0.1.0-alpha.14",
  "description": "Observable Claude-to-Codex research, implementation, and verification delegation",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatasoda/agent-delegator.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-delegator": "bin/agent-delegator.cjs"
  },
  "files": [
    "bin/agent-delegator.cjs",
    "dist",
    "prompts",
    "schemas",
    "examples",
    "docs",
    "README.md",
    "CLAUDE_ACCEPTANCE_HANDOFF.md",
    "CLAUDE_CROSS_REPOSITORY_VALIDATION_HANDOFF.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "agent-delegator": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:cli": "bun build src/cli.ts --target=bun --outfile=dist/agent-delegator",
    "build:library": "bun build src/index.ts --target=node --format=esm --outfile=dist/index.js",
    "build:types": "tsc -p tsconfig.library.json",
    "build": "bun run build:cli && bun run build:library && bun run build:types",
    "prepack": "bun run build",
    "package:smoke": "bun scripts/package-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bun-types": "^1.3.13",
    "ajv": "^8.20.0",
    "typescript": "^5.8.2"
  }
}
