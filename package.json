{
  "name": "@whatasoda/agent-delegator",
  "version": "0.1.0-alpha.0",
  "description": "Claude-main to Codex implementation delegation with reviewable evidence and Briefs",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whatasoda/agent-delegator.git"
  },
  "type": "module",
  "bin": {
    "agent-delegator": "bin/agent-delegator.cjs"
  },
  "files": [
    "bin/agent-delegator.cjs",
    "dist/agent-delegator",
    "prompts",
    "schemas",
    "examples",
    "docs",
    "README.md",
    "CLAUDE_ACCEPTANCE_HANDOFF.md",
    "CLAUDE_CROSS_REPOSITORY_VALIDATION_HANDOFF.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "agent-delegator": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/agent-delegator",
    "prepack": "bun run build",
    "package:smoke": "bun scripts/package-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bun-types": "^1.3.13",
    "ajv": "^8.20.0",
    "typescript": "^5.8.2"
  }
}
