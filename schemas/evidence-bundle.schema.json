{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective",
    "repo_root",
    "generated_at",
    "context_request_sha256",
    "evidence_markdown_sha256",
    "project_profile",
    "sources",
    "excluded_sources"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "objective": { "type": "string", "minLength": 1 },
    "repo_root": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "context_request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_markdown_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "project_profile": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "role",
          "trust",
          "locator",
          "revision",
          "selected_because",
          "snapshot_path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^source-[0-9]{3,}$" },
          "kind": { "type": "string", "enum": ["transcript", "file"] },
          "role": {
            "type": "string",
            "enum": ["policy", "specification", "decision", "context", "implementation", "diagnostic", "external"]
          },
          "trust": { "type": "string", "enum": ["conversation", "project"] },
          "locator": { "type": "string", "minLength": 1 },
          "revision": { "type": ["string", "null"] },
          "selected_because": { "type": "string", "minLength": 1 },
          "snapshot_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "excluded_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "reason"],
        "properties": {
          "locator": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
