{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings", "recommendations", "uncertainties", "follow_up_question"],
  "properties": {
    "status": { "type": "string", "enum": ["answered", "needs-input", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding", "basis"],
        "properties": {
          "finding": { "type": "string", "minLength": 1 },
          "basis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "recommendations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "follow_up_question": { "type": "string" }
  }
}
