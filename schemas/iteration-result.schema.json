{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome", "summary", "changed_files", "implementation_decisions", "brief_deviations",
    "verification", "remaining_risks", "question", "commit_message"
  ],
  "properties": {
    "outcome": { "type": "string", "enum": ["improved", "converged", "needs-decision", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "changed_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "implementation_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "reason"],
        "properties": {
          "decision": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "brief_deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviation", "reason"],
        "properties": {
          "deviation": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "details"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed", "not-run", "environment_blocked"] },
          "details": { "type": "string" }
        }
      }
    },
    "remaining_risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "question": { "type": "string" },
    "commit_message": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\\u0000]*$",
      "description": "Suggested controller commit message, or an empty string when no suggestion applies"
    }
  }
}
