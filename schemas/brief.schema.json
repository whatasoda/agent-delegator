{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective",
    "motivation",
    "current_behavior",
    "desired_behavior",
    "decisions",
    "constraints",
    "scope",
    "implementation_guidance",
    "acceptance_criteria",
    "verification",
    "escalation_conditions",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "objective": { "type": "string" },
    "motivation": { "type": "string" },
    "current_behavior": { "type": "array", "items": { "type": "string" } },
    "desired_behavior": { "type": "array", "items": { "type": "string" } },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement", "status", "rationale", "provenance", "owner_decision_by",
          "owner_decision_at", "sources"
        ],
        "properties": {
          "statement": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["accepted", "rejected", "superseded", "proposed", "unresolved"]
          },
          "rationale": { "type": "string" },
          "provenance": {
            "type": "string",
            "enum": ["evidence", "post_compile_owner_decision"]
          },
          "owner_decision_by": { "type": ["string", "null"] },
          "owner_decision_at": { "type": ["string", "null"] },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "turn", "quote"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1 },
                "turn": { "type": ["integer", "null"], "minimum": 1 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "rule", "rationale", "failure_mode", "sources"],
        "properties": {
          "level": { "type": "string", "enum": ["must", "should", "may"] },
          "rule": { "type": "string" },
          "rationale": { "type": "string" },
          "failure_mode": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "turn", "quote"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1 },
                "turn": { "type": ["integer", "null"], "minimum": 1 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string" } },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "implementation_guidance": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "escalation_conditions": { "type": "array", "items": { "type": "string" } },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "why_it_matters", "sources"],
        "properties": {
          "question": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "turn", "quote"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1 },
                "turn": { "type": ["integer", "null"], "minimum": 1 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
