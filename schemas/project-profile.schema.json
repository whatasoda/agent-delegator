{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_sources", "topics"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1" },
    "default_sources": {
      "type": "array",
      "items": { "$ref": "context-request.schema.json#/$defs/repo_source" }
    },
    "topics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sources"],
        "properties": {
          "sources": {
            "type": "array",
            "items": { "$ref": "context-request.schema.json#/$defs/repo_source" }
          }
        }
      }
    }
  }
}
