{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "status", "objective", "repoRoot", "baseCommit",
    "transcriptPath", "transcriptSessionId", "transcriptResolutionMethod",
    "createdAt", "updatedAt", "compilerModel", "compilerSessionId",
    "implementationModel", "implementationSessionId", "latestResult", "failure"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["collecting", "prepared", "compiling", "compiled", "approved", "implementing", "researching", "verifying", "completed", "needs-decision", "blocked", "failed"]
    },
    "objective": { "type": "string", "minLength": 1 },
    "repoRoot": { "type": "string", "minLength": 1 },
    "baseCommit": { "type": "string", "minLength": 1 },
    "transcriptPath": { "type": "string" },
    "transcriptSessionId": { "type": ["string", "null"] },
    "transcriptResolutionMethod": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "compilerModel": { "type": ["string", "null"] },
    "compilerSessionId": { "type": ["string", "null"] },
    "implementationModel": { "type": ["string", "null"] },
    "implementationSessionId": { "type": ["string", "null"] },
    "latestResult": { "type": ["string", "null"] },
    "failure": { "type": ["string", "null"] },
    "failurePhase": { "type": ["string", "null"], "enum": ["collect", "compile", "implement", "resume", "research", "follow-up", "iterate", "verify", null] },
    "activeOperation": { "type": ["string", "null"], "enum": ["collect", "compile", "implement", "resume", "research", "follow-up", "iterate", "verify", null] },
    "controllerPid": { "type": ["integer", "null"], "minimum": 1 },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collect", "compile", "implement", "resume"],
      "properties": {
        "collect": { "type": "integer", "minimum": 0 },
        "compile": { "type": "integer", "minimum": 0 },
        "implement": { "type": "integer", "minimum": 0 },
        "resume": { "type": "integer", "minimum": 0 }
      }
    },
    "approvedWorktreeSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "lastWorktreeSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "observedWorktreeSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "observedWorktreeChangedFileCount": { "type": ["integer", "null"], "minimum": 0 },
    "observedWorktreePatchBytes": { "type": ["integer", "null"], "minimum": 0 },
    "contextRequestPath": { "type": ["string", "null"] },
    "evidenceBundlePath": { "type": ["string", "null"] },
    "evidenceBundleSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "projectProfilePath": { "type": ["string", "null"] },
    "taskMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_type", "complexity", "tags"],
      "properties": {
        "task_type": {
          "type": "string",
          "enum": ["feature", "bugfix", "refactor", "test", "documentation", "tooling", "migration", "performance", "security", "investigation", "other"]
        },
        "complexity": { "type": "string", "enum": ["small", "medium", "large", "unknown"] },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
          "uniqueItems": true
        }
      }
    },
    "approvalCount": { "type": "integer", "minimum": 0 },
    "evaluationCount": { "type": "integer", "minimum": 0 },
    "latestCheckpointPath": { "type": ["string", "null"] },
    "observationVersion": { "const": 1 },
    "delegatorVersion": { "type": "string", "minLength": 1 },
    "delegatorRevision": { "type": ["string", "null"] },
    "delegatorDirty": { "type": ["boolean", "null"] },
    "delegatorArtifactSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "delegationPattern": { "type": "string", "enum": ["implementation", "research", "interactive", "autonomous"] },
    "experimentVariant": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "researchModel": { "type": ["string", "null"] },
    "researchSessionId": { "type": ["string", "null"] },
    "researchTurnCount": { "type": "integer", "minimum": 0 },
    "iterationCount": { "type": "integer", "minimum": 0 },
    "autonomousStopReason": {
      "type": ["string", "null"],
      "enum": ["converged", "needs-decision", "blocked", "turn-limit", "time-limit", "checkpoint-error", "iteration-failure", null]
    },
    "codexHomeMode": { "type": "string", "enum": ["shared", "isolated", "custom"] },
    "codexHome": { "type": ["string", "null"] },
    "codexAuthStore": { "type": "string", "enum": ["auto", "keyring", "file", "shared-file"] },
    "workspaceWriteNetworkAccess": { "type": "string", "enum": ["inherit", "enabled", "disabled"] },
    "workspaceWriteWritableRoots": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verificationModel": { "type": ["string", "null"] },
    "verificationSessionId": { "type": ["string", "null"] },
    "verificationCount": { "type": "integer", "minimum": 0 },
    "latestVerificationPath": { "type": ["string", "null"] },
    "verificationStatus": { "type": ["string", "null"], "enum": ["passed", "failed", "partial", "not-run", null] },
    "verificationFailure": { "type": ["string", "null"] },
    "verificationNetworkAccess": { "type": "string", "enum": ["inherit", "enabled", "disabled"] },
    "verificationWritableRoots": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
